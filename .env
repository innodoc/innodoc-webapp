# Application base URL (URL the app will be available from the outside)
INNODOC_APP_ROOT=https://app.example.com/

# Course slug mode (SUBDOMAIN, URL, DISABLE)
INNODOC_COURSE_SLUG_MODE=SUBDOMAIN
INNODOC_DEFAULT_COURSE_SLUG=course

# JWT secret (openssl rand -base64 256 | tr -d '\n')
INNODOC_JWT_SECRET="put_your_jwt_token_here"

# Mailer configuration
INNODOC_SMTP_HOST=smtp.example.com
INNODOC_SMTP_PORT=587
INNODOC_SMTP_USER=username
INNODOC_SMTP_PASSWORD=password
INNODOC_SMTP_SENDER=no-reply@example.com

# Database connection string (only PostgreSQL supported)
INNODOC_DB_CONNECTION=postgresql://innodoc:abc123@127.0.0.1:5432/innodoc

# Discourse integration
INNODOC_DISCOURSE_URL=https://discourse.example.com/
INNODOC_DISCOURSE_SSO_SECRET="put_your_sso_secret_here"

### Below are fields that are not mandatory to change.

# Bind address
INNODOC_HOST=localhost

# Bind port
INNODOC_PORT=3000

# First URL component for sections, e.g. example.com/section/a/b
INNODOC_SECTION_PATH_PREFIX=section

# First URL component for pages
INNODOC_PAGE_PATH_PREFIX=page

# settings for development (usually no need to change something here)
#INNODOC_SMTP_SKIP_MAILS=true

# Database debug output
INNODOC_DB_DEBUG=false
