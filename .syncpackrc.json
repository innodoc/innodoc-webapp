{
  "$schema": "./node_modules/syncpack/schema.json",
  "sortAz": [
    "bin",
    "contributors",
    "dependencies",
    "devDependencies",
    "imports",
    "keywords",
    "peerDependencies",
    "resolutions"
  ],
  "sortFirst": [
    "name",
    "version",
    "private",
    "type",
    "sideEffects",
    "exports",
    "imports",
    "scripts",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "resolutions",
    "engines",
    "pnpm"
  ],
  "semverGroups": [
    {
      "packages": ["**"],
      "dependencies": ["@innodoc/*", "@types/innodoc-*"],
      "isIgnored": true
    }
  ],
  "versionGroups": [
    {
      "label": "Internal dev packages are pinned to workspace:*",
      "packages": ["**"],
      "dependencies": ["@innodoc/commands", "@innodoc/configs", "@innodoc/shared-fixtures", "@innodoc/ui-test-utils"],
      "dependencyTypes": ["dev"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Internal prod packages are pinned to workspace:*",
      "packages": ["**"],
      "dependencies": [
        "@innodoc/backend",
        "@innodoc/frontend",
        "@innodoc/shared-core",
        "@innodoc/ui-content",
        "@innodoc/ui-design-system",
        "@innodoc/ui-features",
        "@innodoc/ui-shared",
        "@innodoc/ui-store",
        "@innodoc/server-env",
        "@innodoc/server-db",
        "@innodoc/content-parser"
      ],
      "dependencyTypes": ["prod", "dev"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Types and internal dev packages are banned from dependencies (only allowed in devDependencies)",
      "packages": ["**"],
      "dependencies": [
        "@innodoc/configs",
        "@innodoc/commands",
        "@innodoc/shared-fixtures",
        "@innodoc/ui-test-utils",
        "@types/*",
        "*/types"
      ],
      "dependencyTypes": ["prod"],
      "isBanned": true
    },
    {
      "label": "External deps must use catalog:",
      "packages": ["**"],
      "dependencies": ["*"],
      "dependencyTypes": ["prod", "dev"],
      "pinVersion": "catalog:"
    }
  ]
}
