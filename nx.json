{
  "defaultBase": "main",
  "parallel": 5,
  "namedInputs": {
    "default": ["{projectRoot}/src/**/*"],
    "eslint-config": ["{projectRoot}/eslint.config.js"],
    "tests": ["{projectRoot}/tests/**/*"],
    "ts-config": ["{projectRoot}/tsconfig*.json"]
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "type-check"]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "inputs": ["default", "ts-config", "^tests"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "inputs": ["default", "tests"],
      "dependsOn": ["^build", "build"]
    },
    "lint": {
      "inputs": ["default", "tests", "eslint-config"]
    },
    "type-check": {
      "inputs": ["default", "ts-config", "tests"]
    }
  }
}
