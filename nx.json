{
  "defaultBase": "main",
  "parallel": 5,
  "namedInputs": {
    "default": ["{projectRoot}/src/**/*"],
    "tests": ["{projectRoot}/tests/**/*"]
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test:integration", "test:unit", "type-check"]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "inputs": ["default", "{projectRoot}/tsconfig.build.json", "^tests"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:integration": {
      "inputs": ["default", "{projectRoot}/tests/integration/**/*"]
    },
    "test:unit": {
      "inputs": ["default", "{projectRoot}/tests/unit/**/*"]
    },
    "lint": {
      "inputs": ["default", "tests", "{projectRoot}/eslint.config.js"]
    },
    "type-check": {
      "inputs": ["default", "tests", "{projectRoot}/tsconfig.json"]
    }
  }
}
