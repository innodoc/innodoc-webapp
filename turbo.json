{
  "globalDependencies": [".env*"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "format": {},
    "format:write": {},
    "knex": {
      "cache": false,
      "persistent": true
    },
    "lint:fix": {},
    "lint": {},
    "main": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "playwright:install": {
      "cache": false
    },
    "playwright:show-report": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.test*", "src/**/*.tsx", "src/**/*.ts"]
    },
    "typecheck": {
      "inputs": ["tsconfig*.json"]
    },
    "//#_build:icon-bundle": {
      "dependsOn": ["@innodoc/commands#build"],
      "outputs": ["packages/ui-design-system/dist/icon-bundle.json"],
      "inputs": [
        "packages/ui-content/src/**/*.tsx",
        "packages/ui-design-system/src/**/*.tsx",
        "packages/ui-features/src/**/*.tsx"
      ]
    }
  }
}
