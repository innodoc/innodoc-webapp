{
  "globalDependencies": [".env*"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "format": {},
    "format:write": {},
    "lint": {},
    "lint:fix": {},
    "main": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "playwright:install": {
      "cache": false
    },
    "playwright:show-report": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.test*", "src/**/*.tsx", "src/**/*.ts"]
    },
    "typecheck": {
      "inputs": ["tsconfig*.json"]
    },
    "//#_build:icon-bundle": {
      "dependsOn": ["@innodoc/command-icon-bundle#build"],
      "outputs": ["packages/ui/components-common/dist/iconBundle.json"],
      "inputs": ["packages/ui/components-*/src/**"]
    }
  }
}
