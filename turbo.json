{
  "globalDependencies": [".env*"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "//#fmt:check": {},
    "//#fmt": {},
    "knex": {
      "cache": false,
      "persistent": true
    },
    "//#lint:fix": { "cache": false },
    "//#lint": {},
    "main": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "playwright:install": {
      "cache": false
    },
    "playwright:show-report": {
      "cache": false,
      "persistent": true
    },
    "print-routes": {
      "cache": false
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.test*", "src/**/*.tsx", "src/**/*.ts"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig*.json"]
    }
  }
}
