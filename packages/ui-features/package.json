{
  "name": "@innodoc/ui-features",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./pages": "./dist/pages/pages.js",
    "./render-page": "./dist/page-shell/render-page.js"
  },
  "imports": {
    "#pages/course/content": {
      "types": "./src/pages/course/ContentPage.tsx",
      "default": "./dist/pages/course/ContentPage.js"
    },
    "#pages/error": {
      "types": "./src/pages/ErrorPage.tsx",
      "default": "./dist/pages/ErrorPage.js"
    },
    "#layout": {
      "types": "./src/page-shell/Layout/Layout.tsx",
      "default": "./dist/page-shell/Layout/Layout.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "catalog:",
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/ui-content": "workspace:*",
    "@innodoc/ui-design-system": "workspace:*",
    "@innodoc/ui-shared": "workspace:*",
    "@innodoc/ui-store": "workspace:*",
    "@mui/material": "catalog:",
    "react": "catalog:",
    "react-helmet-async": "catalog:",
    "react-i18next": "catalog:",
    "react-redux": "catalog:"
  },
  "devDependencies": {
    "@innodoc/configs": "workspace:*",
    "@innodoc/ui-test-utils": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vike": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}
