{
  "name": "@innodoc/ui-features",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./page-shell": {
      "types": "./src/page-shell/PageShell/PageShell.tsx",
      "development": "./src/page-shell/PageShell/PageShell.tsx",
      "default": "./dist/page-shell/PageShell/PageShell.js"
    },
    "./routes-switch": {
      "types": "./src/pages/RoutesSwitch.tsx",
      "development": "./src/pages/RoutesSwitch.tsx",
      "default": "./dist/pages/RoutesSwitch.js"
    }
  },
  "imports": {
    "#layout": {
      "types": "./src/page-shell/Layout/Layout.tsx",
      "development": "./src/page-shell/Layout/Layout.tsx",
      "default": "./dist/page-shell/Layout/Layout.js"
    },
    "#pages/course/content": {
      "types": "./src/pages/course/ContentPage.tsx",
      "development": "./src/pages/course/ContentPage.tsx",
      "default": "./dist/pages/course/ContentPage.js"
    },
    "#pages/error": {
      "types": "./src/pages/ErrorPage.tsx",
      "development": "./src/pages/ErrorPage.tsx",
      "default": "./dist/pages/ErrorPage.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "catalog:",
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/ui-content": "workspace:*",
    "@innodoc/ui-design-system": "workspace:*",
    "@innodoc/ui-shared": "workspace:*",
    "@innodoc/ui-store": "workspace:*",
    "@mui/material": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "wouter": "catalog:"
  },
  "devDependencies": {
    "@innodoc/ui-test-utils": "workspace:",
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
