{
  "name": "@innodoc/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./dist/config.js"
  },
  "imports": {
    "#api/errors": "./dist/services/api/errors.js",
    "#config": "./dist/config.js",
    "#plugins/apiReference": "./dist/plugins/apiReference.js",
    "#plugins/db": "./dist/plugins/db/db.js",
    "#plugins/logging": "./dist/plugins/logging.js",
    "#plugins/viteDevServer": "./dist/plugins/viteDevServer.js",
    "#services/api/types": "./dist/services/api/types.js",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "dev:mkcert": "mkcert -install && mkdir -p cert && mkcert -key-file cert/key.pem -cert-file cert/cert.pem innodoc.dev '*.innodoc.dev' localhost 127.0.0.1 ::1",
    "dev:start": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" node ./dist/start.js",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "NODE_ENV=production node ./dist/start.js",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/accepts": "4.3.0",
    "@fastify/autoload": "5.8.0",
    "@fastify/static": "7.0.1",
    "@innodoc/config": "workspace:*",
    "@innodoc/constants": "workspace:*",
    "@innodoc/database": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "camelcase-keys": "^9.1.3",
    "fastify": "4.26.2",
    "fastify-plugin": "4.5.1",
    "fastify-type-provider-zod": "1.1.9",
    "i18next-http-middleware": "3.5.0",
    "validator": "13.11.0",
    "vike": "0.4.165",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@fastify/swagger": "8.14.0",
    "@fastify/vite": "6.0.6",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@reduxjs/toolkit": "2.2.1",
    "@scalar/fastify-api-reference": "1.17.15",
    "@types/node": "^20.11.28",
    "@types/react": "18.2.63",
    "@types/validator": "13.11.9",
    "fastify-print-routes": "3.1.1",
    "pino-pretty": "10.3.1",
    "vite": "5.1.5"
  },
  "nx": {
    "targets": {
      "start": {
        "dependsOn": [
          "^build",
          "build",
          {
            "projects": "@innodoc/frontend",
            "target": "build"
          }
        ],
        "inputs": [
          "{projectRoot}/vite.config.ts",
          "default",
          "^tests"
        ]
      }
    }
  },
  "prettier": "@innodoc/prettier-config"
}
