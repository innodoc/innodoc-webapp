{
  "name": "@innodoc/mock-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./msw/browser": "./dist/msw/makeBrowserServer.js",
    "./msw/node": "./dist/msw/makeNodeServer.js"
  },
  "imports": {
    "#courses": "./dist/data/makeCourses.js",
    "#types": "./dist/data/types.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@innodoc/config": "workspace:*",
    "@innodoc/constants": "workspace:*",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/markdown": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@playwright/test": "^1.42.1",
    "@types/mdast": "4.0.3",
    "@types/node": "^20.11.28",
    "eslint-plugin-playwright": "^1.5.4",
    "iso-639-1": "3.1.2",
    "msw": "^2.2.9",
    "remark-stringify": "11.0.0",
    "type-fest": "4.11.1",
    "unified": "^11.0.4"
  }
}
