{
  "name": "@innodoc/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pages/course/content/onInit": "./src/pages/course/content/onInitContent.ts",
    "#renderer/common": "./src/renderer/common/common.ts",
    "#renderer/route/makeRouteFunc": "./src/renderer/route/makeRouteFunc.ts",
    "#renderer/server/makeOnBeforeRenderContent": "./src/renderer/server/makeOnBeforeRenderContent.ts",
    "#renderer/server/onBeforeRenderDefault": "./src/renderer/server/onBeforeRenderDefault.ts",
    "#route": "./src/route/route.ts",
    "#route/onBeforeRoute": "./src/route/onBeforeRoute.ts"
  },
  "scripts": {
    "build": "vite build --mode production",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "11.11.0",
    "@emotion/react": "11.11.1",
    "@emotion/server": "11.11.0",
    "@fontsource/lato": "5.0.19",
    "@innodoc/components": "workspace:*",
    "@innodoc/constants": "workspace:*",
    "@innodoc/i18n": "workspace:*",
    "@innodoc/markdown": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@mui/material": "5.15.12",
    "@vitejs/plugin-react-swc": "3.6.0",
    "i18next": "23.10.0",
    "i18next-fs-backend": "2.3.1",
    "i18next-http-backend": "2.5.0",
    "katex": "0.16.9",
    "react-dom": "18.2.0",
    "react-helmet-async": "2.0.4",
    "validator": "13.11.0",
    "vike": "0.4.165",
    "vite": "5.1.5"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@reduxjs/toolkit": "2.2.1",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/node": "^20.11.28",
    "@types/react": "18.2.63",
    "@types/react-dom": "18.2.20",
    "@types/validator": "13.11.9",
    "globals": "^14.0.0",
    "rollup-plugin-visualizer": "5.12.0",
    "vitest": "^1.3.1"
  },
  "prettier": "@innodoc/prettier-config"
