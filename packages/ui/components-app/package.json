{
  "name": "@innodoc/components-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/renderPage.js"
  },
  "imports": {
    "#layout": "./dist/Layout/Layout.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@innodoc/components-common": "workspace:*",
    "@innodoc/components-content": "workspace:*",
    "@innodoc/components-pages": "workspace:*",
    "@innodoc/constants": "workspace:*",
    "@innodoc/contexts": "workspace:*",
    "@innodoc/hooks": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/theme": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@mui/material": "5.15.12",
    "react-helmet-async": "2.0.4",
    "react-i18next": "14.0.5",
    "react-redux": "9.1.0",
    "react": "18.2.0"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/rtl": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/react": "18.2.63",
    "i18next": "23.10.0",
    "vike": "0.4.165",
    "vitest": "^1.3.1"
  },
  "prettier": "@innodoc/prettier-config"
}
