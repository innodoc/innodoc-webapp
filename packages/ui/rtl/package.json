{
  "name": "@innodoc/rtl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/rtl-utils.js",
    "./setup": "./dist/rtl-setup.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/contexts": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@mui/material": "5.15.12",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "i18next": "23.10.0",
    "msw": "^2.2.9",
    "react": "18.2.0",
    "react-i18next": "14.0.5",
    "react-redux": "9.1.0",
    "vitest": "^1.3.1"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@types/react": "18.2.63",
    "@types/react-redux": "7.1.33",
    "typescript-eslint": "^7.2.0",
    "vike": "0.4.165"
  },
  "prettier": "@innodoc/prettier-config"
}
