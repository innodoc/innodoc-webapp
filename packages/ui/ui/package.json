{
  "name": "@innodoc/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/components/app/renderPage.js",
    "./pages": "./dist/components/app/pages.js"
  },
  "imports": {
    "#components/common/buttons": "./dist/components/common/buttons/buttons.js",
    "#components/common/errors": "./dist/components/common/errors/errors.js",
    "#components/common/links": "./dist/components/common/links/links.js",
    "#components/common/misc": "./dist/components/common/misc/misc.js",
    "#components/content/cards": "./dist/components/content/cards/cards.js",
    "#components/content/exercises": "./dist/components/content/exercises/exercises.js",
    "#components/content/grid": "./dist/components/content/grid/grid.js",
    "#components/content/hast": "./dist/components/content/hast/hast.js",
    "#components/content/hast/componentsMap": "./dist/components/content/hast/componentsMap.js",
    "#components/content/misc": "./dist/components/content/misc/misc.js",
    "#components/content/tabs": "./dist/components/content/tabs/tabs.js",
    "#components/content/types": "./dist/components/content/types.js",
    "#components/pages": "./dist/components/app/pages.js",
    "#components/pages/content": "./dist/components/app/pages/course/ContentPage.js",
    "#components/pages/error": "./dist/components/app/pages/ErrorPage.js",
    "#components/pages/links": "./dist/components/app/pageLinks.js",
    "#components/toc": "./dist/components/toc/toc.js",
    "#contexts": "./dist/contexts/contexts.js",
    "#hooks/pageContext": "./dist/hooks/usePageContext.js",
    "#hooks/redux": "./dist/hooks/store/redux.js",
    "#hooks/routes": "./dist/hooks/useRouteManager.js",
    "#hooks/select": "./dist/hooks/store/select.js",
    "#iconBundle": "./dist/iconBundle.json",
    "#theme": "./dist/components/app/PageShell/theme.js",
    "#types": "./dist/types/types.js",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:icon-bundle": "mkdir -p dist && innodoc-icon-bundle --force src dist/iconBundle.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@innodoc/constants": "workspace:*",
    "@innodoc/markdown": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@mui/lab": "5.0.0-alpha.167",
    "@mui/material": "5.15.12",
    "@mui/x-tree-view": "^6.17.0",
    "@reduxjs/toolkit": "2.2.1",
    "camelcase-keys": "^9.1.3",
    "clsx": "2.1.0",
    "react": "18.2.0",
    "react-helmet-async": "2.0.4",
    "react-i18next": "14.0.5",
    "react-redux": "9.1.0",
    "rehype-react": "8.0.0",
    "unified": "^11.0.4"
  },
  "devDependencies": {
    "@innodoc/command-icon-bundle": "workspace:*",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@mui/system": "^5.15.12",
    "@types/hast": "3.0.4",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/react": "18.2.63",
    "@types/react-redux": "7.1.33",
    "@types/svg-parser": "2.0.6",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "i18next": "23.10.0",
    "iso-639-1": "3.1.2",
    "vike": "0.4.165"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "build:icon-bundle"
        ]
      },
      "build:icon-bundle": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^tests"
        ],
        "outputs": [
          "{projectRoot}/dist/iconBundle.json"
        ]
      }
    }
  },
  "prettier": "@innodoc/prettier-config"
}
