{
  "name": "@innodoc/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/pages/pages.js",
    "./renderPage": "./dist/app/renderPage.js"
  },
  "imports": {
    "#common/buttons": "./dist/common/buttons/buttons.js",
    "#common/errors": "./dist/common/errors/errors.js",
    "#common/links": "./dist/common/links/links.js",
    "#common/misc": "./dist/common/misc/misc.js",
    "#content/cards": "./dist/content/cards/cards.js",
    "#content/exercises": "./dist/content/exercises/exercises.js",
    "#content/grid": "./dist/content/grid/grid.js",
    "#content/hast": "./dist/content/hast/hast.js",
    "#content/hast/componentsMap": "./dist/content/hast/componentsMap.js",
    "#content/misc": "./dist/content/misc/misc.js",
    "#content/tabs": "./dist/content/tabs/tabs.js",
    "#content/types": "./dist/content/types.js",
    "#pageLinks": "./dist/pageLinks.js",
    "#pages": "./dist/pages/pages.js",
    "#pages/content": "./dist/pages/course/ContentPage.js",
    "#pages/error": "./dist/pages/ErrorPage.js",
    "#theme": "./dist/theme.js",
    "#toc": "./dist/toc/toc.js",
    "#types": "./dist/types/types.js",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@innodoc/constants": "workspace:*",
    "@innodoc/contexts": "workspace:*",
    "@innodoc/hooks": "workspace:*",
    "@innodoc/markdown": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@mui/lab": "5.0.0-alpha.167",
    "@mui/material": "5.15.12",
    "@mui/x-tree-view": "^6.17.0",
    "camelcase-keys": "^9.1.3",
    "clsx": "2.1.0",
    "react": "18.2.0",
    "react-helmet-async": "2.0.4",
    "react-i18next": "14.0.5",
    "react-redux": "9.1.0",
    "rehype-react": "8.0.0",
    "unified": "^11.0.4"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/rtl": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@innodoc/vitest-config": "workspace:*",
    "@mui/system": "^5.15.12",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/hast": "3.0.4",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/react": "18.2.63",
    "@types/react-redux": "7.1.33",
    "@types/svg-parser": "2.0.6",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "i18next": "23.10.0",
    "vike": "0.4.165",
    "vitest": "^1.3.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": "innodoc",
            "target": "build:icon-bundle"
          }
        ]
      }
    }
  },
  "prettier": "@innodoc/prettier-config"
}
