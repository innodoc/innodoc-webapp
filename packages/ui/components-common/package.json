{
  "name": "@innodoc/components-common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./buttons": "./dist/buttons/buttons.js",
    "./errors": "./dist/errors/errors.js",
    "./links": "./dist/links/links.js",
    "./misc": "./dist/misc/misc.js",
    "./pageLinks": "./dist/pageLinks.js",
    "./toc": "./dist/toc/toc.js",
    "./utils": "./dist/utils.js"
  },
  "imports": {
    "#errors": "./dist/errors/errors.js",
    "#iconBundle": "./dist/iconBundle.json",
    "#links": "./dist/links/links.js",
    "#misc": "./dist/misc/misc.js",
    "#pageLinks": "./dist/pageLinks.js",
    "#toc": "./dist/toc/toc.js",
    "#types": "./src/types/types.ts",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/hooks": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@mui/lab": "5.0.0-alpha.167",
    "@mui/material": "5.15.12",
    "@mui/x-tree-view": "^6.17.0",
    "clsx": "2.1.0",
    "react": "18.2.0",
    "react-i18next": "14.0.5"
  },
  "devDependencies": {
    "@emotion/styled": "11.11.0",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/rtl": "workspace:*",
    "@innodoc/theme": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@innodoc/vitest-config": "workspace:*",
    "@mui/system": "^5.15.12",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/react": "18.2.63",
    "@types/svg-parser": "2.0.6",
    "vitest": "^1.3.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": "innodoc",
            "target": "build:icon-bundle"
          }
        ]
      }
    }
  },
  "prettier": "@innodoc/prettier-config"
}
