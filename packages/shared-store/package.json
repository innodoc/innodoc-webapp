  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/shared-core": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "crc": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "iso-639-1": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
