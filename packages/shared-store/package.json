    "./slices/content/pages": {
      "types": "./src/slices/content/entities/pages.ts",
      "development": "./src/slices/content/entities/pages.ts",
      "default": "./dist/slices/content/entities/pages.js"
    },
    "./slices/content/entities/pages": {
