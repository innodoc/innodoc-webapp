    "#types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "#utils": {
      "types": "./src/utils/index.ts",
      "development": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    }
