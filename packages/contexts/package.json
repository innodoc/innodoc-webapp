{
  "name": "@innodoc/contexts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/contexts.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vike": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
