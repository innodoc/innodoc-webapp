{
  "name": "@innodoc/ui-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contexts": {
      "types": "./src/contexts/contexts.ts",
      "development": "./src/contexts/contexts.ts",
      "default": "./dist/contexts/contexts.js"
    },
    "./hooks": {
      "types": "./src/hooks/hooks.ts",
      "development": "./src/hooks/hooks.ts",
      "default": "./dist/hooks/hooks.js"
    }
  },
  "imports": {
    "#contexts": {
      "types": "./src/contexts/contexts.ts",
      "development": "./src/contexts/contexts.ts",
      "default": "./dist/contexts/contexts.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/shared-core": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
