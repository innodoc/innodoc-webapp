{
  "name": "@innodoc/components-pages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/pages.js"
  },
  "imports": {
    "#content": "./src/course/ContentPage.js",
    "#error": "./src/ErrorPage.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/components-common": "workspace:*",
    "@innodoc/components-content": "workspace:*",
    "@innodoc/hooks": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@mui/material": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/rtl": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@innodoc/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
