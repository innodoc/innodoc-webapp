{
  "name": "@innodoc/shared-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./constants": "./dist/constants.js",
    "./i18n": "./dist/i18n.js",
    "./routes": "./dist/routes/routes.js",
    "./routes/manager/vite": "./dist/routes/manager/get-route-manager.vite.js",
    "./schemas": "./dist/schemas/schemas.js",
    "./types": {
      "types": "./dist/types/types.d.ts"
    },
    "./typeguards": "./dist/typeguards/typeguards.js"
  },
  "imports": {
    "#constants": {
      "types": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "#routes": {
      "types": "./src/routes/routes.ts",
      "default": "./dist/routes/routes.js"
    },
    "#routes/api-routes": {
      "types": "./src/routes/api-routes.ts"
    },
    "#routes/course-routes": {
      "types": "./src/routes/course-routes.ts"
    },
    "#schemas": {
      "types": "./src/schemas/schemas.ts",
      "default": "./dist/schemas/schemas.js"
    },
    "#schemas/common": {
      "types": "./src/schemas/common.ts",
      "default": "./dist/schemas/common.js"
    },
    "#typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    },
    "#types": {
      "types": "./src/types/types.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "catalog:",
    "i18next-http-backend": "catalog:",
    "path-to-regexp": "catalog:",
    "react-i18next": "catalog:",
    "validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@innodoc/configs": "workspace:*",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "@types/validator": "catalog:",
    "i18next-fs-backend": "catalog:",
    "iso-639-1": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}
