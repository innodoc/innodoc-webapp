{
  "name": "@innodoc/shared-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "development": "./src/icons.ts",
      "default": "./dist/icons.js"
    },
    "./i18n": {
      "types": "./src/i18n.ts",
      "development": "./src/i18n.ts",
      "default": "./dist/i18n.js"
    },
    "./routes": {
      "types": "./src/routes/routes.ts",
      "development": "./src/routes/routes.ts",
      "default": "./dist/routes/routes.js"
    },
    "./schemas": {
      "types": "./src/schemas/schemas.ts",
      "development": "./src/schemas/schemas.ts",
      "default": "./dist/schemas/schemas.js"
    },
    "./translate": {
      "types": "./src/translate.ts",
      "development": "./src/translate.ts",
      "default": "./dist/translate.js"
    },
    "./types": {
      "types": "./src/types/types.ts",
      "development": "./src/types/types.ts"
    },
    "./typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "development": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    }
  },
  "imports": {
    "#constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "#icons": {
      "types": "./src/icons.ts",
      "development": "./src/icons.ts",
      "default": "./dist/icons.js"
    },
    "#routes": {
      "types": "./src/routes/routes.ts",
      "development": "./src/routes/routes.ts",
      "default": "./dist/routes/routes.js"
    },
    "#routes/api-routes": {
      "types": "./src/routes/api-routes.ts",
      "development": "./src/routes/api-routes.ts",
      "default": "./dist/routes/api-routes.js"
    },
    "#routes/builtin-routes": {
      "types": "./src/routes/builtin-routes.ts",
      "development": "./src/routes/builtin-routes.ts",
      "default": "./dist/routes/builtin-routes.js"
    },
    "#routes/course-routes": {
      "types": "./src/routes/course-routes.ts",
      "development": "./src/routes/course-routes.ts",
      "default": "./dist/routes/course-routes.js"
    },
    "#routes/user-routes": {
      "types": "./src/routes/user-routes.ts",
      "development": "./src/routes/user-routes.ts",
      "default": "./dist/routes/user-routes.js"
    },
    "#schemas": {
      "types": "./src/schemas/schemas.ts",
      "development": "./src/schemas/schemas.ts",
      "default": "./dist/schemas/schemas.js"
    },
    "#schemas/common": {
      "types": "./src/schemas/common.ts",
      "development": "./src/schemas/common.ts",
      "default": "./dist/schemas/common.js"
    },
    "#translate": {
      "types": "./src/translate.ts",
      "development": "./src/translate.ts",
      "default": "./dist/translate.js"
    },
    "#typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "development": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    },
    "#typeguards/content": {
      "types": "./src/typeguards/content.ts",
      "development": "./src/typeguards/content.ts",
      "default": "./dist/typeguards/content.js"
    },
    "#typeguards/routes": {
      "types": "./src/typeguards/routes.ts",
      "development": "./src/typeguards/routes.ts",
      "default": "./dist/typeguards/routes.js"
    },
    "#types": {
      "types": "./src/types/types.ts",
      "development": "./src/types/types.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json"
  },
  "dependencies": {
    "hast-util-is-element": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "regexparam": "catalog:",
    "validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/validator": "catalog:",
    "@typescript/native": "catalog:",
    "iso-639-1": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "type-fest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
