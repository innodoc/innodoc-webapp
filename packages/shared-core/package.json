{
  "name": "@innodoc/shared-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "#routes": {
      "types": "./src/routes/routes.ts",
      "development": "./src/routes/routes.ts",
      "default": "./dist/routes/routes.js"
    },
    "#routes/api-routes": {
      "types": "./src/routes/api-routes.ts",
      "development": "./src/routes/api-routes.ts",
      "default": "./dist/routes/api-routes.js"
    },
    "#routes/course-routes": {
      "types": "./src/routes/course-routes.ts",
      "development": "./src/routes/course-routes.ts",
      "default": "./dist/routes/course-routes.js"
    },
    "#schemas": {
      "types": "./src/schemas/schemas.ts",
      "development": "./src/schemas/schemas.ts",
      "default": "./dist/schemas/schemas.js"
    },
    "#schemas/common": {
      "types": "./src/schemas/common.ts",
      "development": "./src/schemas/common.ts",
      "default": "./dist/schemas/common.js"
    },
    "#types": {
      "types": "./src/types/types.ts",
      "development": "./src/types/types.ts"
    },
    "#typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "development": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    }
  },
  "exports": {
    "./constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./i18n": {
      "types": "./src/i18n.ts",
      "development": "./src/i18n.ts",
      "default": "./dist/i18n.js"
    },
    "./routes": {
      "types": "./src/routes/routes.ts",
      "development": "./src/routes/routes.ts",
      "default": "./dist/routes/routes.js"
    },
    "./schemas": {
      "types": "./src/schemas/schemas.ts",
      "development": "./src/schemas/schemas.ts",
      "default": "./dist/schemas/schemas.js"
    },
    "./types": {
      "types": "./src/types/types.ts",
      "development": "./src/types/types.ts"
    },
    "./typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "development": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "catalog:",
    "react-i18next": "catalog:",
    "regexparam": "catalog:",
    "validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "@types/validator": "catalog:",
    "iso-639-1": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
