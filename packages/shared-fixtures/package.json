{
  "name": "@innodoc/shared-fixtures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./browser": {
      "types": "./src/make-browser-server.ts",
      "development": "./src/make-browser-server.ts",
      "default": "./dist/make-browser-server.js"
    },
    "./node": {
      "types": "./src/make-node-server.ts",
      "development": "./src/make-node-server.ts",
      "default": "./dist/make-node-server.js"
    },
    "./courses": {
      "types": "./src/data/make-courses.ts",
      "development": "./src/data/make-courses.ts",
      "default": "./dist/data/make-courses.js"
    },
    "./types": {
      "types": "./src/data/types.ts",
      "development": "./src/data/types.ts",
      "default": "./dist/data/types.js"
    }
  },
  "imports": {
    "#courses": {
      "types": "./src/data/make-courses.ts",
      "development": "./src/data/make-courses.ts",
      "default": "./dist/data/make-courses.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@innodoc/server-env": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "iso-639-1": "catalog:",
    "msw": "catalog:",
    "remark-stringify": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:"
  }
}
