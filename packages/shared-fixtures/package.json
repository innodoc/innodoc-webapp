    "@innodoc/shared-core": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "iso-639-1": "catalog:",
    "msw": "catalog:",
    "remark-stringify": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:"
  }
