{
  "name": "@innodoc/shared-fixtures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./msw/browser": "./dist/msw/make-browser-server.js",
    "./msw/node": "./dist/msw/make-node-server.js"
