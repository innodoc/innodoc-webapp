{
  "name": "@innodoc/server-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/Database.ts",
      "development": "./src/Database.ts",
      "default": "./dist/Database.js"
    }
  },
  "imports": {
    "#database": {
      "types": "./src/Database.ts",
      "development": "./src/Database.ts",
      "default": "./dist/Database.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "knex": "NODE_OPTIONS='--import tsx/esm' knex --knexfile src/knex-config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/server-env": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "iso-639-1": "catalog:",
    "knex": "catalog:",
    "pg": "catalog:",
    "pg-protocol": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsx": "catalog:"
  }
}
