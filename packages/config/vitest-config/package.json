    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "vitest": "^1.3.1"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
