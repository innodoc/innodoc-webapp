{
  "name": "@innodoc/vitest-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./unit": "./vitest.config.unit.js",
    "./integration": "./vitest.config.integration.js"
  },
  "scripts": {
