{
  "name": "@innodoc/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": "./dist/Database.js",
  "imports": {
    "#database": "./src/Database.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "knex": "NODE_OPTIONS='--import tsx' knex --knexfile src/knexConfig.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/constants": "workspace:*",
    "@innodoc/container": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "iso-639-1": "catalog:",
    "knex": "catalog:",
    "pg": "8.11.3",
    "pg-protocol": "1.6.0"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
