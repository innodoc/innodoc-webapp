{
  "name": "@innodoc/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./database": "./src/database/getDatabase.ts"
  },
  "imports": {
    "#api/errors": "./src/services/api/errors.ts",
    "#config": "./src/config.ts",
    "#plugins/apiReference": "./src/plugins/apiReference.ts",
    "#plugins/db": "./src/plugins/db/db.ts",
    "#plugins/logging": "./src/plugins/logging.ts",
    "#plugins/viteDevServer": "./src/plugins/viteDevServer.ts",
    "#services/api/types": "./src/services/api/types.ts",
    "#utils": "./src/utils.ts"
  },
  "scripts": {
    "dev": "tsx ./src/start.ts",
    "dev:mkcert": "mkcert -install && mkdir -p cert && mkcert -key-file cert/key.pem -cert-file cert/cert.pem innodoc.dev '*.innodoc.dev' localhost 127.0.0.1 ::1",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/accepts": "4.3.0",
    "@fastify/autoload": "5.8.0",
    "@fastify/static": "7.0.1",
    "@innodoc/config": "workspace:^",
    "@innodoc/constants": "workspace:^",
    "@innodoc/database": "workspace:^",
    "@innodoc/routes": "workspace:^",
    "@innodoc/schema": "workspace:^",
    "@innodoc/typeguards": "workspace:^",
    "camelcase-keys": "9.1.3",
    "fastify": "4.26.2",
    "fastify-plugin": "4.5.1",
    "fastify-type-provider-zod": "1.1.9",
    "i18next-http-middleware": "3.5.0",
    "vike": "0.4.165",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@fastify/swagger": "8.14.0",
    "@fastify/vite": "6.0.6",
    "@innodoc/eslint-config": "workspace:^",
    "@innodoc/store": "workspace:^",
    "@innodoc/ts-config": "workspace:^",
    "@innodoc/types": "workspace:^",
    "@reduxjs/toolkit": "2.2.1",
    "@scalar/fastify-api-reference": "1.17.15",
    "@types/node": "20.11.24",
    "@types/react": "18.2.63",
    "fastify-print-routes": "3.1.1",
    "globals": "14.0.0",
    "pino-pretty": "10.3.1",
    "vite": "5.1.5"
  }
}
