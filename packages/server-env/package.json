{
  "name": "@innodoc/server-env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/parse-config.ts",
      "development": "./src/parse-config.ts",
      "default": "./dist/parse-config.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/shared-core": "workspace:*",
    "vite": "catalog:",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@innodoc/configs": "workspace:*",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}
