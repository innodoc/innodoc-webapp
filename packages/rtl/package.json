{
  "name": "@innodoc/rtl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/rtl-utils.js",
    "./setup": "./dist/rtl-setup.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@innodoc/config": "workspace:*",
    "@innodoc/contexts": "workspace:*",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/mock-content": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@mui/material": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-redux": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "react-redux": "catalog:",
    "typescript-eslint": "catalog:",
    "vike": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
