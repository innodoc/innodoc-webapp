    "@iconify-json/mdi": "1.1.64",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "2.1.22",
    "@innodoc/eslint-config": "workspace:^",
    "@innodoc/ts-config": "workspace:^",
    "@innodoc/types": "workspace:^",
    "@types/eslint": "8.56.5",
    "@types/svg-parser": "2.0.6",
    "camelcase-keys": "9.1.3",
    "hast-util-is-element": "3.0.0",
    "knex": "3.1.0",
    "rehype-parse": "9.0.0",
    "svg-parser": "2.0.4",
    "unified": "11.0.4",
    "unist-util-remove-position": "5.0.0",
    "yaml": "2.4.0"
