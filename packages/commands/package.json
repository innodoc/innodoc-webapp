{
  "name": "@innodoc/commands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./icon-bundle": "./dist/iconBundle.json"
  },
  "scripts": {
    "build-icon-bundle": "ts-node src/buildIconBundle/main.ts",
    "import": "ts-node src/importer/main.ts",
    "lint": "eslint .",
