{
  "name": "@innodoc/command-import-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "run": "node dist/main.js",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/database": "workspace:*",
    "camelcase-keys": "^9.1.3",
    "knex": "^3.1.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@types/eslint": "^8.56.5",
    "@types/node": "^20.11.28"
  },
  "prettier": "@innodoc/prettier-config"
}
