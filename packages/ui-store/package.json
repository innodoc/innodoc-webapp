{
  "name": "@innodoc/ui-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/make-store.js",
    "./hooks": "./dist/hooks/hooks.js",
    "./slices/app": "./dist/slices/app/app-slice.js",
    "./slices/content": "./dist/slices/content/content-api.js",
    "./slices/content/courses": "./dist/slices/content/entities/courses.js",
    "./slices/content/fragments": "./dist/slices/content/entities/fragments.js",
    "./slices/content/pages": "./dist/slices/content/entities/pages.js",
    "./slices/content/sections": "./dist/slices/content/entities/sections.js",
    "./slices/hast": "./dist/slices/hast/hast-slice.js",
    "./types": "./dist/types.js",
    "./utils": "./dist/utils.js"
  },
  "imports": {
    "#slices/app": {
      "types": "./src/slices/app/app-slice.ts",
      "default": "./dist/slices/app/app-slice.js"
    },
    "#slices/content": {
      "types": "./src/slices/content/content-api.ts",
      "default": "./dist/slices/content/content-api.js"
    },
    "#slices/content/courses": {
      "types": "./src/slices/content/entities/courses.ts",
      "default": "./dist/slices/content/entities/courses.js"
    },
    "#slices/content/fragments": {
      "types": "./src/slices/content/entities/fragments.ts",
      "default": "./dist/slices/content/entities/fragments.js"
    },
    "#slices/content/pages": {
      "types": "./src/slices/content/entities/pages.ts",
      "default": "./dist/slices/content/entities/pages.js"
    },
    "#slices/content/sections": {
      "types": "./src/slices/content/entities/sections.ts",
      "default": "./dist/slices/content/entities/sections.js"
    },
    "#slices/hast": {
      "types": "./src/slices/hast/hast-slice.ts",
      "default": "./dist/slices/hast/hast-slice.js"
    },
    "#types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "#utils": {
      "types": "./src/utils.ts",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/content-parser": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "crc": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:",
    "svg-parser": "catalog:"
  },
  "devDependencies": {
    "@innodoc/configs": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-redux": "catalog:",
    "@types/svg-parser": "catalog:",
    "iso-639-1": "catalog:",
    "redux": "catalog:",
    "redux-thunk": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}
