{
  "name": "@innodoc/components-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/hast/hast.js"
  },
  "imports": {
    "#cards": "./dist/cards/cards.js",
    "#exercises": "./dist/exercises/exercises.js",
    "#hast": "./dist/hast/hast.js",
    "#hast/components": "./dist/hast/componentsMap.js",
    "#tabs": "./dist/tabs/tabs.js",
    "#types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/components-common": "workspace:*",
    "@innodoc/constants": "workspace:*",
    "@innodoc/contexts": "workspace:*",
    "@innodoc/hooks": "workspace:*",
    "@innodoc/markdown": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/theme": "workspace:*",
    "@mui/lab": "catalog:",
    "@mui/material": "catalog:",
    "camelcase-keys": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "rehype-react": "8.0.0",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/rtl": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@innodoc/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@types/hast": "catalog:",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/react": "catalog:",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
