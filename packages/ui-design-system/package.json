{
  "name": "@innodoc/ui-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./buttons": "./dist/buttons/buttons.js",
    "./errors": "./dist/errors/errors.js",
    "./links": "./dist/links/links.js",
    "./misc": "./dist/misc/misc.js",
    "./pageLinks": "./dist/pageLinks.js",
    "./theme": "./dist/theme/theme.js",
    "./toc": "./dist/toc/toc.js",
    "./types/mui": {
      "types": "./src/theme/mui.d.ts"
    },
    "./utils": "./dist/utils.js"
  },
  "imports": {
    "#errors": "./dist/errors/errors.js",
    "#iconBundle": "./dist/iconBundle.json",
    "#links": "./dist/links/links.js",
    "#misc": "./dist/misc/misc.js",
    "#pageLinks": "./dist/pageLinks.js",
    "#theme": "./dist/theme.js",
    "#toc": "./dist/toc/toc.js",
    "#types": "./src/types/types.ts",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/ui-shared": "workspace:*",
    "@innodoc/ui-store": "workspace:*",
    "@mui/lab": "catalog:",
    "@mui/material": "catalog:",
    "@mui/x-tree-view": "catalog:",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@emotion/styled": "catalog:",
    "@innodoc/configs": "workspace:*",
    "@innodoc/ui-test-utils": "workspace:*",
    "@mui/system": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/svg-parser": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}
