{
  "name": "@innodoc/ui-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./buttons": {
      "types": "./src/buttons/buttons.ts",
      "development": "./src/buttons/buttons.ts",
      "default": "./dist/buttons/buttons.js"
    },
    "./errors": {
      "types": "./src/errors/errors.ts",
      "development": "./src/errors/errors.ts",
      "default": "./dist/errors/errors.js"
    },
    "./links": {
      "types": "./src/links/links.ts",
      "development": "./src/links/links.ts",
      "default": "./dist/links/links.js"
    },
    "./misc": {
      "types": "./src/misc/misc.ts",
      "development": "./src/misc/misc.ts",
      "default": "./dist/misc/misc.js"
    },
    "./page-links": {
      "types": "./src/page-links.tsx",
      "development": "./src/page-links.tsx",
      "default": "./dist/page-links.js"
    },
    "./theme": {
      "types": "./src/theme/theme.ts",
      "development": "./src/theme/theme.ts",
      "default": "./dist/theme/theme.js"
    },
    "./toc": {
      "types": "./src/toc/toc.ts",
      "development": "./src/toc/toc.ts",
      "default": "./dist/toc/toc.js"
    },
    "./types/mui": {
      "types": "./src/theme/mui.d.ts",
      "development": "./src/theme/mui.d.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "development": "./src/utils.ts",
      "default": "./dist/utils.js"
    }
  },
  "imports": {
    "#errors": {
      "types": "./src/errors/errors.ts",
      "development": "./src/errors/errors.ts",
      "default": "./dist/errors/errors.js"
    },
    "#icon-bundle": {
      "default": "./dist/icon-bundle.json"
    },
    "#links": {
      "types": "./src/links/links.ts",
      "development": "./src/links/links.ts",
      "default": "./dist/links/links.js"
    },
    "#misc": {
      "types": "./src/misc/misc.ts",
      "development": "./src/misc/misc.ts",
      "default": "./dist/misc/misc.js"
    },
    "#page-links": {
      "types": "./src/page-links.tsx",
      "development": "./src/page-links.tsx",
      "default": "./dist/page-links.js"
    },
    "#theme": {
      "types": "./src/theme/theme.ts",
      "development": "./src/theme/theme.ts",
      "default": "./dist/theme/theme.js"
    },
    "#toc": {
      "types": "./src/toc/toc.ts",
      "development": "./src/toc/toc.ts",
      "default": "./dist/toc/toc.js"
    },
    "#utils": {
      "types": "./src/utils.ts",
      "development": "./src/utils.ts",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/ui-shared": "workspace:*",
    "@innodoc/ui-store": "workspace:*",
    "@mui/lab": "catalog:",
    "@mui/material": "catalog:",
    "@mui/x-tree-view": "catalog:",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@emotion/styled": "catalog:",
    "@innodoc/ui-test-utils": "workspace:*",
    "@mui/system": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/svg-parser": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
