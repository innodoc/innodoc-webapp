{
  "name": "@innodoc/ui-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*-worker.*",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/hast/hast.ts",
      "development": "./src/hast/hast.ts",
      "default": "./dist/hast/hast.js"
    },
    "./hast-listener-middleware": {
      "types": "./src/hast-listener-middleware/hast-listener-middleware.ts",
      "development": "./src/hast-listener-middleware/hast-listener-middleware.ts",
      "default": "./dist/hast-listener-middleware/hast-listener-middleware.js"
    }
  },
  "imports": {
    "#cards": {
      "types": "./src/cards/cards.ts",
      "development": "./src/cards/cards.ts",
      "default": "./dist/cards/cards.js"
    },
    "#exercises": {
      "types": "./src/exercises/exercises.ts",
      "development": "./src/exercises/exercises.ts",
      "default": "./dist/exercises/exercises.js"
    },
    "#grid": {
      "types": "./src/grid/grid.ts",
      "development": "./src/grid/grid.ts",
      "default": "./dist/grid/grid.js"
    },
    "#hast": {
      "types": "./src/hast/hast.ts",
      "development": "./src/hast/hast.ts",
      "default": "./dist/hast/hast.js"
    },
    "#hast/components": {
      "types": "./src/hast/components-map.ts",
      "development": "./src/hast/components-map.ts",
      "default": "./dist/hast/components-map.js"
    },
    "#misc": {
      "types": "./src/misc/misc.ts",
      "development": "./src/misc/misc.ts",
      "default": "./dist/misc/misc.js"
    },
    "#tabs": {
      "types": "./src/tabs/tabs.ts",
      "development": "./src/tabs/tabs.ts",
      "default": "./dist/tabs/tabs.js"
    },
    "#types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts"
    },
    "#video": {
      "types": "./src/video/video.ts",
      "development": "./src/video/video.ts",
      "default": "./dist/video/video.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json"
  },
  "dependencies": {
    "@innodoc/content-parser": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/shared-store": "workspace:*",
    "@innodoc/ui-design-system": "workspace:*",
    "@innodoc/ui-shared": "workspace:*",
    "@mui/lab": "catalog:",
    "@mui/material": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "rehype-react": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
