{
  "name": "@innodoc/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/entities.ts",
    "./common": "./src/common.ts",
    "./config": "./src/config.ts",
    "./typeGuards": "./src/typeGuards.ts"
  },
  "imports": {
    "#common": "./src/common.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@innodoc/constants": "workspace:^",
    "@innodoc/utils": "workspace:^",
    "validator": "13.11.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:^",
    "@innodoc/ts-config": "workspace:^",
    "@innodoc/types": "workspace:^",
    "@types/validator": "13.11.9"
  }
}
