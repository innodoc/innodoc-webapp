{
  "name": "@innodoc/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/makeStore.js",
    "./slices/app": "./dist/slices/app/appSlice.js",
    "./slices/content": "./dist/slices/content/contentApi.js",
    "./slices/content/courses": "./dist/slices/content/entities/courses.js",
    "./slices/content/fragments": "./dist/slices/content/entities/fragments.js",
    "./slices/content/pages": "./dist/slices/content/entities/pages.js",
    "./slices/content/sections": "./dist/slices/content/entities/sections.js",
    "./slices/hast": "./dist/slices/hast/hastSlice.js",
    "./types": "./dist/types.js",
    "./utils": "./dist/utils.js"
  },
  "imports": {
    "#slices/app": "./dist/slices/app/appSlice.js",
    "#slices/content": "./dist/slices/content/contentApi.js",
    "#slices/content/courses": "./dist/slices/content/entities/courses.js",
    "#slices/content/fragments": "./dist/slices/content/entities/fragments.js",
    "#slices/content/pages": "./dist/slices/content/entities/pages.js",
    "#slices/content/sections": "./dist/slices/content/entities/sections.js",
    "#slices/hast": "./dist/slices/hast/hastSlice.js",
    "#types": "./dist/types.js",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/constants": "workspace:*",
    "@innodoc/markdown": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@reduxjs/toolkit": "2.2.1",
    "crc": "4.3.2",
    "i18next": "23.10.0",
    "react-redux": "9.1.0",
    "svg-parser": "2.0.4"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/react-redux": "7.1.33",
    "@types/svg-parser": "2.0.6",
    "iso-639-1": "3.1.2",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  },
  "prettier": "@innodoc/prettier-config"
}
