{
  "name": "@innodoc/routes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./node/getRouteManager": "./dist/getRouteManagerNode.js",
    "./vite/getRouteManager": "./dist/getRouteManagerVite.js",
    "./types": "./dist/types/common.js",
    "./types/routeInfos": "./dist/types/routeInfos.js",
    "./types/routeNames": "./dist/types/routeNames.js",
    "./typeguards": "./dist/typeguards.js"
  },
  "imports": {
    "#routeManager": "./dist/RouteManager.js",
    "#routes": "./dist/routes/routes.js",
    "#types/common": "./dist/types/common.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch --project tsconfig.build.json",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/constants": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "path-to-regexp": "6.2.1"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@innodoc/vitest-config": "workspace:*",
    "@types/innodoc-vite-env": "workspace:*",
    "@types/node": "^20.11.28",
    "iso-639-1": "3.1.2",
    "vitest": "^1.3.1"
  },
  "prettier": "@innodoc/prettier-config"
}
