{
  "name": "@innodoc/typeguards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./common": "./dist/common.js",
    "./content": "./dist/content.js",
    "./errors": "./dist/errors.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/constants": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "iso-639-1": "3.1.2",
    "validator": "13.11.0"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@types/svg-parser": "2.0.6",
    "@types/validator": "13.11.9"
  },
  "prettier": "@innodoc/prettier-config"
}
