{
  "name": "@innodoc/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/entities.js",
    "./common": "./dist/common.js",
    "./config": "./dist/config.js",
    "./types": "./dist/types.js"
  },
  "imports": {
    "#common": "./dist/common.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/constants": "workspace:*",
    "validator": "13.11.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@types/validator": "13.11.9",
    "type-fest": "4.11.1"
  },
  "prettier": "@innodoc/prettier-config"
}
