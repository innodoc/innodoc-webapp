{
  "name": "@innodoc/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/markdownToHast.js",
    "./properties": "./dist/sanitization/properties.js",
    "./typeguards": "./dist/typeguards.js",
    "./types": "./dist/types.js",
    "./utils": "./dist/utils.js"
  },
  "imports": {
    "#typeguards": "./dist/typeguards.js",
    "#types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/constants": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "hast-util-is-element": "catalog:",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-mdx-jsx": "3.1.0",
    "mdast-util-to-hast": "13.1.0",
    "micromark-extension-gfm-strikethrough": "2.0.0",
    "micromark-extension-gfm-table": "2.0.0",
    "micromark-extension-mdx-jsx": "3.0.0",
    "micromark-extension-mdx-md": "2.0.0",
    "rehype-katex": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-heading-id": "1.0.1",
    "remark-inline-links": "7.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.0",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "3.0.2",
    "hast-util-sanitize": "5.0.1"
  },
  "prettier": "@innodoc/prettier-config"
}
