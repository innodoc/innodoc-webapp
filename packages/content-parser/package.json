{
  "name": "@innodoc/content-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/markdown-to-hast.ts",
      "development": "./src/markdown-to-hast.ts",
      "default": "./dist/markdown-to-hast.js"
    },
    "./properties": {
      "types": "./src/sanitization/properties.ts",
      "development": "./src/sanitization/properties.ts",
      "default": "./dist/sanitization/properties.js"
    },
    "./typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "development": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "development": "./src/utils.ts",
      "default": "./dist/utils.js"
    }
  },
  "imports": {
    "#typeguards": {
      "types": "./src/typeguards/typeguards.ts",
      "development": "./src/typeguards/typeguards.ts",
      "default": "./dist/typeguards/typeguards.js"
    },
    "#types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/shared-core": "workspace:*",
    "hast-util-is-element": "catalog:",
    "mdast-util-gfm-strikethrough": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "mdast-util-to-hast": "catalog:",
    "micromark-extension-gfm-strikethrough": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "micromark-extension-mdx-jsx": "catalog:",
    "micromark-extension-mdx-md": "catalog:",
    "rehype-katex": "catalog:",
    "rehype-sanitize": "catalog:",
    "rehype-slug": "catalog:",
    "remark-heading-id": "catalog:",
    "remark-inline-links": "catalog:",
    "remark-math": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/remark-heading-id": "catalog:",
    "@types/unist": "catalog:",
    "hast-util-sanitize": "catalog:",
    "typescript": "catalog:"
  }
}
