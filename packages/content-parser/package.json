{
  "name": "@innodoc/content-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/markdown-to-hast.js",
    "./properties": "./dist/sanitization/properties.js",
    "./typeguards": "./dist/typeguards/typeguards.js",
    "./types": "./dist/types.js",
    "./utils": "./dist/utils.js"
  },
  "imports": {
    "#typeguards": "./dist/typeguards/typeguards.js",
    "#types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/shared-core": "workspace:*",
    "hast-util-is-element": "catalog:",
    "mdast-util-gfm-strikethrough": "catalog:",
    "mdast-util-gfm-table": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "mdast-util-to-hast": "catalog:",
    "micromark-extension-gfm-strikethrough": "catalog:",
    "micromark-extension-gfm-table": "catalog:",
    "micromark-extension-mdx-jsx": "catalog:",
    "micromark-extension-mdx-md": "catalog:",
    "rehype-katex": "catalog:",
    "rehype-sanitize": "catalog:",
    "rehype-slug": "catalog:",
    "remark-heading-id": "catalog:",
    "remark-inline-links": "catalog:",
    "remark-math": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@innodoc/configs": "workspace:*",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "hast-util-sanitize": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}
