{
  "name": "@innodoc/typeguards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./common": "./src/common.ts",
    "./content": "./src/content.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@innodoc/constants": "workspace:^",
    "iso-639-1": "3.1.2"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:^",
    "@innodoc/ts-config": "workspace:^",
    "@innodoc/types": "workspace:^",
    "@types/svg-parser": "2.0.6"
  }
}
