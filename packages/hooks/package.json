{
  "name": "@innodoc/hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/hooks.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innodoc/contexts": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:"
  },
  "devDependencies": {
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@types/react": "catalog:",
    "iso-639-1": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
