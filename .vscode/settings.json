{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "json.schemas": [
    {
      "fileMatch": ["**/turbo.json"],
      "url": "https://turbo.build/schema.json"
    },
    {
      "fileMatch": ["/.syncpackrc.json"],
      "url": "./node_modules/syncpack/dist/schema.json"
    },
    {
      "fileMatch": [
        "/tooling/ts-config/*.json",
        "!/tooling/ts-config/package.json",
        "/apps/*/tsconfig*.json",
        "/packages/*/tsconfig*.json",
        "/tooling/*/tsconfig*.json"
      ],
      "url": "http://json.schemastore.org/tsconfig"
    }
  ],
  "editor.formatOnSave": true,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "pattern": "./packages/*/*" }],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "search.exclude": {
    "**/dist": true,
    "pnpm-lock.yaml": true
  }
}
