{
  "name": "@innodoc/commands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "print-routes": "tsx --conditions=development src/print-routes/main.ts",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@innodoc/server-db": "workspace:*",
    "@innodoc/server-env": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "camelcase-keys": "catalog:",
    "chalk": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "knex": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "innodoc-import-v1": "./dist/import-v1/main.js",
    "innodoc-print-routes": "./dist/print-routes/main.js"
  }
}
