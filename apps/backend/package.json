{
  "name": "@innodoc/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "#plugins/types": {
      "types": "./src/plugins/types.ts"
    },
    "#utils": {
      "types": "./src/utils.ts",
      "development": "./src/utils.ts",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "",
    "clean": "rm -rf dist",
    "dev": "tsx watch --conditions=development --include='../../packages/**/*' --exclude='./../frontend/**/*' --exclude='../../packages/*/node_modules' --clear-screen=false src/main.ts",
    "dev:mkcert": "mkcert -install && mkdir -p cert && mkcert -key-file cert/key.pem -cert-file cert/cert.pem innodoc.dev '*.innodoc.dev' localhost 127.0.0.1 ::1",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "NODE_ENV=production node ./dist/main.js",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/awilix": "catalog:",
    "@fastify/static": "catalog:",
    "@innodoc/frontend": "workspace:*",
    "@innodoc/server-db": "workspace:*",
    "@innodoc/server-env": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/ui-store": "workspace:*",
    "@unhead/react": "catalog:",
    "awilix": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "i18next-fs-backend": "catalog:",
    "i18next-http-middleware": "catalog:",
    "pino-pretty": "catalog:"
  },
  "devDependencies": {
    "@fastify/middie": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "i18next": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:"
  },
  "bin": {
    "innodoc-webapp": "./dist/main.js"
  },
  "prettier": "@innodoc/configs/prettierrc.json"
}