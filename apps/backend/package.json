{
  "name": "@innodoc/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/errors": {
      "types": "./src/plugins/api/errors.ts",
      "development": "./src/plugins/api/errors.ts",
      "default": "./dist/plugins/api/errors.js"
    },
    "#api/types": {
      "types": "./src/plugins/api/types.ts",
      "development": "./src/plugins/api/types.ts",
      "default": "./dist/plugins/api/types.js"
    },
    "#constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "#plugins/api/mock-database": {
      "types": "./src/plugins/api/mock-database.ts",
      "development": "./src/plugins/api/mock-database.ts"
    },
    "#plugins/types": {
      "types": "./src/plugins/types.ts",
      "development": "./src/plugins/types.ts"
    },
    "#utils": {
      "types": "./src/utils.ts",
      "development": "./src/utils.ts",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch --conditions=development --include='../../packages/**/*' --exclude='./../frontend/**/*' --exclude='../../packages/*/node_modules' --clear-screen=false src/main.ts",
    "dev:mkcert": "mkcert -install && mkdir -p cert && mkcert -key-file cert/key.pem -cert-file cert/cert.pem innodoc.dev '*.innodoc.dev' localhost 127.0.0.1 ::1",
    "start": "NODE_ENV=production node ./dist/main.js",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/awilix": "catalog:",
    "@fastify/static": "catalog:",
    "@innodoc/frontend": "workspace:*",
    "@innodoc/server-db": "workspace:*",
    "@innodoc/server-env": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/shared-store": "workspace:*",
    "awilix": "catalog:",
    "camelcase-keys": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "i18next-fs-backend": "catalog:",
    "i18next-http-middleware": "catalog:",
    "pino-pretty": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fastify/middie": "catalog:",
    "@fastify/swagger": "catalog:",
    "@innodoc/shared-fixtures": "workspace:*",
    "@scalar/fastify-api-reference": "catalog:",
    "@types/node": "catalog:",
    "iso-639-1": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:"
  },
  "bin": {
    "innodoc-webapp": "./dist/main.js"
  }
}
