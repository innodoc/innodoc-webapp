{
  "name": "@innodoc/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "innodoc-webapp": "./dist/main.js"
  },
  "imports": {
    "#api/errors": "./dist/services/api/errors.js",
    "#plugins/api-reference": "./dist/plugins/api-reference.js",
    "#plugins/db": "./dist/plugins/db/db.js",
    "#plugins/logging": "./dist/plugins/logging.js",
    "#plugins/vite-dev-server": "./dist/plugins/vite-dev-server.js",
    "#services/api/types": "./dist/services/api/types.js",
    "#utils": "./dist/utils.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "nodemon --ext ts --watch ./src --exec 'turbo run dev:start --filter=server --log-prefix=none'",
    "dev:mkcert": "mkcert -install && mkdir -p cert && mkcert -key-file cert/key.pem -cert-file cert/cert.pem innodoc.dev '*.innodoc.dev' localhost 127.0.0.1 ::1",
    "dev:start": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" tsx ./src/main.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "NODE_ENV=production node ./dist/main.js",
    "test:unit": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/accepts": "catalog:",
    "@fastify/autoload": "catalog:",
    "@fastify/static": "catalog:",
    "@innodoc/constants": "workspace:*",
    "@innodoc/container": "workspace:*",
    "@innodoc/database": "workspace:*",
    "@innodoc/routes": "workspace:*",
    "@innodoc/schema": "workspace:*",
    "@innodoc/typeguards": "workspace:*",
    "camelcase-keys": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "i18next-http-middleware": "catalog:",
    "validator": "catalog:",
    "vike": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fastify/swagger": "catalog:",
    "@fastify/vite": "catalog:",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "@innodoc/store": "workspace:*",
    "@innodoc/ts-config": "workspace:*",
    "@innodoc/types": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "@scalar/fastify-api-reference": "catalog:",
    "@types/node": "catalog:",
    "@types/validator": "catalog:",
    "fastify-print-routes": "catalog:",
    "nodemon": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@innodoc/prettier-config"
}
