{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["dev:mkcert"]
    },
    "dev:mkcert": {
      "cache": true,
      "inputs": ["__NONE__"],
      "outputs": ["cert/cert.pem", "cert/key.pem"]
    },
    "dev:start": {
      "cache": false,
      "dependsOn": [],
      "persistent": false
    }
  }
}
