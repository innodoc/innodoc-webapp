{
  "name": "@innodoc/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "default": "./dist/server/index.js"
    },
    "./populate-store": {
      "types": "./src/populate-store.ts",
      "default": "./src/populate-store.ts"
    }
  },
  "imports": {},
