    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/server": "catalog:",
    "@innodoc/content-parser": "workspace:*",
    "@innodoc/shared-core": "workspace:*",
    "@innodoc/shared-store": "workspace:*",
    "@innodoc/ui-features": "workspace:*",
    "@innodoc/ui-shared": "workspace:*",
    "@unhead/react": "catalog:",
    "camelcase-keys": "catalog:",
    "crc": "catalog:",
    "buffer": "catalog:",
    "i18next-http-backend": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-redux": "catalog:",
    "vite": "catalog:",
    "wouter": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "i18next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
