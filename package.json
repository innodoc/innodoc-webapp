{
  "name": "innodoc",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "========= Build": "",
    "build": "nx run-many --target=build --exclude=innodoc",
    "build:icon-bundle": "nx run innodoc:build-icon-bundle",
    "clean": "nx run-many --target=clean --exclude=innodoc",
    "========= Commands": "",
    "import-v1": "nx run @innodoc/command-import-v1:run",
    "routes": "nx run @innodoc/command-print-routes:run",
    "========= Depcruise": "",
    "depcruise": "pnpm run depcruise:generate && pnpm run depcruise:serve",
    "depcruise:generate": "pnpm run depcruise:generate:full && pnpm run depcruise:generate:high-level && pnpm run depcruise:generate:violation-report",
    "depcruise:generate:full": "mkdir -p reports/depcruise && pnpm exec depcruise apps packages --config --output-type dot | dot -T svg | pnpm exec depcruise-wrap-stream-in-html > reports/depcruise/dependency-graph.html",
    "depcruise:generate:high-level": "mkdir -p reports/depcruise && pnpm exec depcruise apps packages --config --output-type archi | dot -T svg | pnpm exec depcruise-wrap-stream-in-html > reports/depcruise/dependency-graph-high-level.html",
    "depcruise:generate:violation-report": "mkdir -p reports/depcruise && pnpm exec depcruise apps packages --config --output-type err-html --output-to reports/depcruise/dependency-violation-report.html",
    "depcruise:serve": "http-server -p 8001 reports/depcruise",
    "depcruise:validate": "pnpm exec depcruise --config -- apps packages",
    "========= Development": "",
    "dev": "nx run-many --target=dev --exclude=innodoc",
    "dev:checks": "pnpm run lint && pnpm run format && pnpm run type-check && pnpm run syncpack lint && pnpm run depcruise:validate && pnpm run test && pnpm run test:e2e",
    "dev:mkcert": "nx run @innodoc/server:dev:mkcert",
    "dev:mock": "#TODO INNODOC_API_MOCK=true INNODOC_DEFAULT_COURSE_SLUG=testcourse INNODOC_COURSE_SLUG_MODE=SINGLE nodemon --ext ts --watch ./src/server --exec tsx ./src/server/startMockServer.ts",
    "========= Format": "",
    "format": "nx run-many --target=format --exclude=innodoc",
    "format:write": "nx run-many --target=format:write --exclude=innodoc",
    "========= Lint": "",
    "lint": "nx run-many --target=lint --exclude=innodoc",
    "lint:fix": "nx run-many --target=lint:fix --exclude=innodoc",
    "========= Production": "",
    "start": "NODE_ENV=production nx run @innodoc/server:start",
    "========= Test": "",
    "test": "nx run-many --target=test --exclude=innodoc",
    "test:e2e": "nx run @innodoc/e2e-tests:test",
    "========= Tools": "",
    "knex": "nx run @innodoc/database:knex",
    "knip": "knip",
    "syncpack": "pnpm exec syncpack",
    "visualize-bundle": "VISUALIZE_BUNDLE=true pnpm run build",
    "========= Type-check": "",
    "type-check": "nx run-many --target=type-check --exclude=innodoc"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.1.0",
    "@commitlint/config-conventional": "^19.1.0",
    "@innodoc/command-icon-bundle": "workspace:*",
    "@innodoc/eslint-config": "workspace:*",
    "@innodoc/prettier-config": "workspace:*",
    "commit-and-tag-version": "12.2.0",
    "dependency-cruiser": "^16.2.3",
    "eslint": "^8.57.0",
    "knip": "^5.0.4",
    "nx": "^18.0.8",
    "prettier": "^3.2.5",
    "syncpack": "12.3.0",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "pnpm": {
    "patchedDependencies": {
      "decode-named-character-reference@1.0.2": "patches/decode-named-character-reference@1.0.2.patch",
      "hast-util-from-html-isomorphic@2.0.0": "patches/hast-util-from-html-isomorphic@2.0.0.patch"
    }
  },
  "commit-and-tag-version": {
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "nx": {
    "targets": {
      "build-icon-bundle": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "commands": [
            "mkdir -p dist",
            "innodoc-icon-bundle --force --output packages/ui/components-common/dist/iconBundle.json packages/ui/components-app/src packages/ui/components-common/src packages/ui/components-content/src packages/ui/components-pages/src"
          ]
        },
        "dependsOn": [
          {
            "projects": "@innodoc/command-icon-bundle",
            "target": "build"
          }
        ],
        "inputs": [
          "{workspaceRoot}/packages/ui/components-app/src",
          "{workspaceRoot}/packages/ui/components-common/src",
          "{workspaceRoot}/packages/ui/components-content/src",
          "{workspaceRoot}/packages/ui/components-pages/src"
        ],
        "outputs": [
          "{workspaceRoot}/packages/ui/components-common/dist/iconBundle.json"
        ]
      }
    }
  },
  "prettier": "@innodoc/prettier-config"
}
