{
  "name": "innodoc",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "========= Build": "",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "========= Commands": "",
    "import-v1": "turbo run --filter=@innodoc/command-import-v1 main",
    "routes": "turbo run --filter=@innodoc/commands --log-prefix=none --output-logs=new-only --ui=stream print-routes",
    "========= Depcruise": "",
    "depcruise": "pnpm run depcruise:generate && pnpm run depcruise:serve",
    "depcruise:generate": "pnpm run depcruise:generate:full && pnpm run depcruise:generate:high-level && pnpm run depcruise:generate:violation-report",
    "depcruise:generate:full": "mkdir -p reports/depcruise && pnpm exec depcruise apps packages --config --output-type dot | dot -T svg | pnpm exec depcruise-wrap-stream-in-html > reports/depcruise/dependency-graph.html",
    "depcruise:generate:high-level": "mkdir -p reports/depcruise && pnpm exec depcruise apps packages --config --output-type archi | dot -T svg | pnpm exec depcruise-wrap-stream-in-html > reports/depcruise/dependency-graph-high-level.html",
    "depcruise:generate:violation-report": "mkdir -p reports/depcruise && pnpm exec depcruise apps packages --config --output-type err-html --output-to reports/depcruise/dependency-violation-report.html",
    "depcruise:serve": "pnpm dlx http-server -p 8001 reports/depcruise",
    "depcruise:validate": "pnpm exec depcruise --config -- apps packages",
    "========= Development": "",
    "dev": "pnpm --filter=@innodoc/backend run dev",
    "dev:checks": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run syncpack && pnpm run depcruise:validate && pnpm run knip && pnpm run test && pnpm run test:e2e",
    "dev:mock": "INNODOC_API_MOCK=true INNODOC_PUBLIC_COURSE_SLUG_MODE=${INNODOC_PUBLIC_COURSE_SLUG_MODE:-SINGLE} INNODOC_PUBLIC_DEFAULT_COURSE_SLUG=test-course pnpm dev",
    "========= Format": "",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check",
    "========= Lint": "",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "========= Production": "",
    "start": "NODE_ENV=production turbo run --filter=@innodoc/backend start",
    "========= Release": "",
    "release": "commit-and-tag-version",
    "release:alpha": "commit-and-tag-version -p alpha",
    "release:beta": "commit-and-tag-version -p beta",
    "release:ga": "commit-and-tag-version -r 2.0.0",
    "release:rc": "commit-and-tag-version -p rc",
    "========= Test": "",
    "test": "turbo run test --filter=!@innodoc/e2e --output-logs=new-only",
    "test:e2e": "turbo run test --filter=@innodoc/e2e --ui=stream",
    "test:e2e:show-report": "turbo run playwright:show-report --log-prefix=none --filter=@innodoc/e2e",
    "========= Tools": "",
    "deps:upgrade": "taze major --interactive",
    "knex": "turbo run knex",
    "knip": "knip",
    "prepare": "husky || true",
    "syncpack": "pnpm run syncpack:fmt:check && pnpm run syncpack:lint",
    "syncpack:fmt:check": "pnpm exec syncpack format --check",
    "syncpack:lint": "pnpm exec syncpack lint",
    "visualize-bundle": "VISUALIZE_BUNDLE=true pnpm run build",
    "========= Typecheck": "",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@innodoc/configs": "workspace:*",
    "@typescript/native": "catalog:",
    "commit-and-tag-version": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-config-presets": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "syncpack": "catalog:",
    "taze": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=25.4",
    "pnpm": ">=10"
  },
  "commit-and-tag-version": {
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n",
    "compareUrlFormat": "https://github.com/innodoc/innodoc-webapp/compare/{{previousTag}}...{{currentTag}}",
    "commitUrlFormat": "https://github.com/innodoc/innodoc-webapp/commit/{{hash}}",
    "issueUrlFormat": "https://github.com/innodoc/innodoc-webapp/issues/{{id}}"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@11.7.0"
}
