{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreBinaries": ["dot"],
      "ignoreDependencies": ["@commitlint/cli", "commit-and-tag-version", "oxlint-config-presets"]
    },
    "apps/backend": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["mkcert", "vitest"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/frontend": {
      "project": ["src/**/*.ts?(x)"],
      "ignoreDependencies": ["@emotion/server"]
    },
    "apps/e2e": {
      "entry": [],
      "project": ["tests/**/*.ts"]
    },
    "packages/content-parser": {
      "project": ["src/**/*.ts?(x)"],
      "ignoreBinaries": ["vitest"]
    },
    "packages/server-db": {
      "entry": ["src/migrations/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["vitest"],
      "ignoreDependencies": ["pg", "pg-protocol"]
    },
    "packages/server-env": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["vitest"]
    },
    "packages/shared-core": {
      "project": ["src/**/*.ts?(x)"],
      "vitest": {
        "entry": ["src/**/*.test.ts?(x)"]
      }
    },
    "packages/shared-fixtures": {
      "project": ["src/**/*.ts?(x)"],
      "ignoreDependencies": ["@innodoc/server-env", "@playwright/test", "type-fest"]
    },
    "packages/ui-content": {
      "entry": ["src/hast-listener-middleware/markdown-to-hast-worker.ts"],
      "project": ["src/**/*.ts?(x)"]
    },
    "packages/ui-design-system": {
      "project": ["src/**/*.ts?(x)"],
      "vitest": {
        "entry": ["src/**/*.test.ts?(x)"]
      }
    },
    "packages/shared-store": {
      "project": ["src/**/*.ts?(x)"],
      "ignoreBinaries": ["vitest"]
    },
    "packages/ui-test-utils": {
      "entry": ["src/rtl-utils.tsx", "src/rtl-setup.ts", "src/stub-globals.ts"],
      "project": ["src/**/*.ts?(x)"]
    },
    "tooling/commands": {
      "entry": ["src/import-v1/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["vitest"]
    }
  }
}
